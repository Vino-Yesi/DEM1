# Copy to .env for local development. These are LOCAL-ONLY examples; replace
# every password and DSN with managed secrets before deploying anywhere public.
# Keep passwords URL-safe when embedding them in PostgreSQL URLs.
POSTGRES_PASSWORD=local_admin_change_me
WMS_APP_PASSWORD=local_app_change_me
WMS_MIGRATION_PASSWORD=local_migration_change_me

WMS_DATABASE_URL=postgresql://wms_app:local_app_change_me@db:5432/wms?options=-csearch_path%3Dwms,public
WMS_SYSTEM_DATABASE_URL=postgresql://wms_migration:local_migration_change_me@db:5432/wms?options=-csearch_path%3Dwms,public
